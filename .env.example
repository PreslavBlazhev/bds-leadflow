# BDS LeadFlow — примерна конфигурация. САМО placeholders, без тайни.
# `npm run setup:demo` копира този файл в .env, ако .env липсва (никога не го презаписва).

# Режим: demo | real. DEMO_MODE не е визуален флаг — забранява реални доставки и външни заявки.
APP_MODE=demo
# SQLite файл (относително спрямо prisma/). demo и real ТРЯБВА да са различни файлове.
# Real пример: file:../data/real.db
DATABASE_URL=file:../data/demo.db
# Локален адрес (слуша само на 127.0.0.1). Използва се за CSRF/origin проверка и линкове в известия.
APP_BASE_URL=http://localhost:3015
# Валидност на сесията в часове.
SESSION_TTL_HOURS=168
# Интервал на worker-а в секунди.
WORKER_TICK_SECONDS=30

# Web Push (VAPID). Само публичният ключ отива в браузъра. setup:demo генерира локални ключове.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: адрес на собственика (не се показва публично)
VAPID_SUBJECT=

# Резервен имейл — ЕДИН транспорт (SMTP). Изпраща се само до OWNER_NOTIFY_EMAIL.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Разрешен подател при твоя SMTP доставчик (не приемай, че личен Gmail е разрешен)
SMTP_FROM=
# Твоят адрес за резервни известия (не е зададен по подразбиране)
OWNER_NOTIFY_EMAIL=

# Google Places read-through — BLOCKED, докато не са потвърдени условията за ЕИП/CRM и e2e потокът.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TERMS_CONFIRMED=false
# Live автоматично откриване на кандидати (изключено)
LIVE_DISCOVERY_ENABLED=false
# Live проверка на сайтове със SSRF защита (изключено)
LIVE_WEB_AUDIT_ENABLED=false
# Разрешава ЕДНА изрична реална тестова доставка до мен в real режим (неутрален текст)
ALLOW_REAL_TEST_DELIVERY=false
