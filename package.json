{
  "name": "bds-leadflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3015",
    "worker:dev": "tsx src/worker/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "prebuild": "node scripts/guard-no-dev.mjs",
    "build": "next build",
    "prestart": "node scripts/guard-no-dev.mjs",
    "start": "next start -H 127.0.0.1 -p 3015",
    "start:web": "node scripts/start-web.mjs",
    "worker:start": "node --import tsx src/worker/index.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "owner:create": "tsx scripts/owner-create.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build",
    "jobs:daily:dry-run": "tsx scripts/daily-dry-run.ts",
    "demo:next-day": "tsx scripts/demo-next-day.ts",
    "backup": "tsx scripts/backup.ts",
    "postinstall": "prisma generate && node scripts/prisma-pg.mjs generate",
    "real:init": "tsx scripts/real-init.ts",
    "real:owner": "node scripts/with-env.mjs .env.real tsx scripts/owner-create.ts",
    "real:dev": "node scripts/with-env.mjs .env.real node scripts/dev-all.mjs",
    "real:backup": "node scripts/with-env.mjs .env.real tsx scripts/backup.ts",
    "import:xlsx": "tsx scripts/import-xlsx.ts",
    "import:xlsx:verify": "tsx scripts/verify-xlsx-import.ts",
    "pilot:discover": "node scripts/with-env.mjs .env.real tsx scripts/pilot-discover.ts",
    "db:generate": "prisma generate && node scripts/prisma-pg.mjs generate",
    "db:pg:schema": "node scripts/prisma-pg-schema.mjs",
    "db:pg:schema:check": "node scripts/prisma-pg-schema.mjs --check",
    "db:deploy": "node scripts/prisma-pg.mjs migrate deploy",
    "db:status": "node scripts/prisma-pg.mjs migrate status",
    "pg:local": "node scripts/pg-local.mjs",
    "pg:backup": "tsx scripts/pg-backup.ts backup",
    "pg:restore-check": "tsx scripts/pg-backup.ts restore-check",
    "migrate:export": "tsx scripts/migrate-data.ts export",
    "migrate:dry-run": "tsx scripts/migrate-data.ts dry-run",
    "migrate:import": "tsx scripts/migrate-data.ts import",
    "migrate:verify": "tsx scripts/migrate-data.ts verify",
    "test:pg": "node scripts/test-pg.mjs",
    "notifications:release": "tsx scripts/notifications-release.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "ipaddr.js": "2.5.0",
    "libphonenumber-js": "1.13.14",
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tldts": "7.4.16",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
