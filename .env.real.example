# BDS LeadFlow — REAL режим (първи реални бизнеси). САМО placeholders, без тайни.
# `npm run real:init` копира този файл в .env.real, ако липсва (никога не го презаписва).
# .env.real е в .gitignore. Ключовете се въвеждат само тук, локално — не в чат.

APP_MODE=real
# Реалната база е ИЗВЪН папката на проекта (без demo записи, без риск от наблюдението на dev сървъра).
DATABASE_URL=file:%LOCALAPPDATA%/BDS-LeadFlow/real.db
APP_BASE_URL=http://localhost:3015
SESSION_TTL_HOURS=168
WORKER_TICK_SECONDS=30

# Известия — празни, докато не се настроят (в real режим празно = BLOCKED, не success).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_NOTIFY_EMAIL=

# Google Places API (New) — сървърен ключ, ограничен само до "Places API (New)" и по IP.
GOOGLE_PLACES_API_KEY=
# true само след като си прочел условията за ЕИП и си съгласен с ограниченията (съхранява се само place_id).
GOOGLE_PLACES_TERMS_CONFIRMED=false
# true само за пилотното откриване (npm run pilot:discover -- --run).
LIVE_DISCOVERY_ENABLED=false
# Твърди месечни лимити, прилагани от приложението (над тях заявките се отказват).
# Place Details Enterprise: 1000 безплатни/месец по ценоразписа → лимит 900 оставя резерв.
PLACES_MAX_DETAILS_PER_MONTH=900
# Text Search "само ID" е безплатно без лимит; лимитът пази от грешка в цикъл.
PLACES_MAX_SEARCH_PER_MONTH=2000

LIVE_WEB_AUDIT_ENABLED=false
ALLOW_REAL_TEST_DELIVERY=false
