# BDS LeadFlow — PRODUCTION променливи (Render). САМО placeholders и безопасни defaults — без реални стойности.
# Задават се в Render (env група leadflow-shared = само фиксирани стойности; всичко със sync:false = на ниво услуга),
# НЕ в този файл и НЕ в Git. Виж docs/RENDER-SETUP.md §3 (кои са нужни за първи старт).
# [първи старт] = задължително при създаването; [известия] = може да е празно, добавя се при настройването на известията.
#
# Колони в коментарите: [тип] [secret|public|config] [обхват: web / worker / двете] — смисъл. Default = поведение при липса.
# NEXT_PUBLIC_* стойностите стигат до браузъра → там има САМО публичния VAPID ключ. Никакви тайни с NEXT_PUBLIC_.

# --- Среда (APP_ENV, APP_MODE: група leadflow-shared, фиксирани в render.yaml) ---
# [enum local|production] [config] [двете] — production: изисква PostgreSQL, APP_MODE=real, https APP_BASE_URL; иначе отказ при старт.
APP_ENV=production
# [enum demo|real] [config] [двете] — production е винаги real.
APP_MODE=real
# [https URL, само origin] [config] [web И worker, sync:false — ЕДНАКВА стойност в двете] [първи старт] — canonical адрес: CSRF/Origin проверка, линкове в имейла. Никога от Host header.
APP_BASE_URL=https://leadflow.example.com
# [CSV от https origins] [config] [web, sync:false] [по избор] — допълнителни разрешени Origin (напр. onrender адреса при собствен домейн). Default: няма.
ALLOWED_ORIGINS=

# --- База (на ниво услуга, fromDatabase → connectionString) ---
# [postgresql URL] [secret] [двете] — ВЪТРЕШНИЯТ Render URL (същата region). Външен адрес изисква ?sslmode=require.
# Без sslaccept=accept_invalid_certs. SQLite (file:) е забранен в production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME

# --- Production gates (виж docs/CUTOVER-AND-ROLLBACK.md) ---
# [true|false] [config] [worker] — подготовка/публикуване на дневните списъци. Default в production: false.
SCHEDULER_ENABLED=false
# [true|false] [config] [двете: worker изпраща; web разрешава реален тест] — реални push/имейл доставки. Default в production: false.
DELIVERIES_ENABLED=false
# [true|false] [config] [worker] — изгражда push/имейл (VAPID подпис, криптиране, MIME), но НЕ изпраща; статус simulated.
NOTIFY_DRY_RUN=false
# [true|false] [config] [web] — бутонът за ЕДНА реална тестова доставка в Настройки (неутрален текст). Default: false.
ALLOW_REAL_TEST_DELIVERY=false

# --- Worker ---
# [секунди 5–600] [config] [worker] — честота на проверките (Europe/Sofia се изчислява в кода). Default 30.
WORKER_TICK_SECONDS=30
# [секунди 30–3600] [config] [двете] — heartbeat по-стар от това → owner вижда „Worker не работи“. Default 180.
WORKER_STALE_SECONDS=180

# --- Web ---
# [часове 1–720] [config] [web] — валидност на owner сесията. Default 168.
SESSION_TTL_HOURS=168
# [0–5] [config] [web] — доверени proxy hops за X-Forwarded-For (rate limit по IP). Render: 1. Default production: 1.
TRUSTED_PROXY_HOPS=1
# PORT се задава от Render; start:web слуша на 0.0.0.0:$PORT.

# --- Web Push (VAPID). Генерирай веднъж: npx web-push generate-vapid-keys (локално, не в чат/лог) ---
# [base64url] [public] [web И worker, sync:false — ЕДНАКВА стойност в двете] [известия] — публичен по предназначение;
# абонаментите са обвързани с него. Render игнорира sync:false в env групи, затова не е в групата.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [base64url] [secret] [worker] [известия] — подписва push заявките. Само в worker-а.
VAPID_PRIVATE_KEY=
# [mailto:…] [config] [worker] [известия] — контакт за push доставчиците (адрес на собственика).
VAPID_SUBJECT=mailto:owner@example.com

# --- Резервен имейл (един SMTP доставчик, един получател) — всички [worker] [известия] ---
# [host] [config] [worker]
SMTP_HOST=
# [число] [config] [worker] — обикновено 587 (STARTTLS) или 465 (SMTP_SECURE=true).
SMTP_PORT=587
# [true|false] [config] [worker]
SMTP_SECURE=false
# [текст] [secret] [worker]
SMTP_USER=
# [текст] [secret] [worker]
SMTP_PASS=
# [имейл] [config] [worker] — разрешен подател при доставчика (SPF/DKIM за домейна).
SMTP_FROM=
# [имейл] [config] [worker] — единственият получател на резервните имейли (owner).
OWNER_NOTIFY_EMAIL=

# --- Изключени в production (не се задават) ---
# GOOGLE_PLACES_API_KEY, LIVE_DISCOVERY_ENABLED, LIVE_WEB_AUDIT_ENABLED — няма автоматично откриване/обход на външни сайтове.
